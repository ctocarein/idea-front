# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# outillage local
.claude/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files : les modèles *.example sont versionnés, les vrais .env jamais.
.env*
!.env.example
!.env.staging.example
!.env.production.example
# exception temporaire : on versionne le .env.staging (pas de secret) le temps du staging.
!.env.staging

# outillage IA / docs internes : non versionnés
docs/
AGENTS.md
CLAUDE.md

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
