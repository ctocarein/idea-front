# =============================================================================
# Front Ideaxion — STAGING (modèle). À fournir au runtime du conteneur / à l'hébergeur.
# Front sur https://staging.ideaxion.pro · API sur https://staging.ideaxion.cloud
# =============================================================================

# --- API (server-only ; SANS /api/v1). Public par défaut ; si front+API partagent le même
#     réseau Docker, préférer le nom de service interne (ex. http://api:8000). ---
BACKEND_API_URL=https://staging.ideaxion.cloud

# --- URL publique de CE front (SEO/canonical) ---
NEXT_PUBLIC_SITE_URL=https://ideaxion.pro

# --- Toujours "production" pour un déploiement (cookies Secure, pas de devtools). ---
NODE_ENV=production

# --- Feature flags (V2 masqué en staging aussi, sauf test) ---
NEXT_PUBLIC_FEATURE_PITCH_SIM=false
NEXT_PUBLIC_FEATURE_MENTORS=false
