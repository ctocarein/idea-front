# =============================================================================
# Front Ideaxion — PRODUCTION (modèle). À fournir au runtime du conteneur / à l'hébergeur.
# Front sur https://ideaxion.pro · API sur https://prod.ideaxion.cloud
# =============================================================================

# --- API (server-only ; SANS /api/v1). Public par défaut ; nom de service interne si
#     front+API co-localisés dans le même réseau (ex. http://api:8000). ---
BACKEND_API_URL=https://prod.ideaxion.cloud

# --- URL publique de CE front (SEO/canonical/hreflang) ---
NEXT_PUBLIC_SITE_URL=https://ideaxion.pro

# --- Toujours "production" pour un déploiement. ---
NODE_ENV=production

# --- Feature flags (V2 masqué) ---
NEXT_PUBLIC_FEATURE_PITCH_SIM=false
NEXT_PUBLIC_FEATURE_MENTORS=false
