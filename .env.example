# =============================================================================
# Front Ideaxion (Next.js) — modèle d'environnement (VERSIONNÉ, sans secret).
# Copier en `.env.local`. BFF server-only : le navigateur ne voit JAMAIS BACKEND_API_URL.
#
# ┌─ ENDPOINTS PAR ENVIRONNEMENT ──────────────────────────────────────────────┐
# │ env      │ NEXT_PUBLIC_SITE_URL (ce front) │ BACKEND_API_URL (l'API .cloud)  │
# │ local    │ http://localhost:3000           │ http://127.0.0.1:8082           │
# │ staging  │ https://staging.ideaxion.pro    │ https://staging.ideaxion.cloud  │
# │ prod     │ https://ideaxion.pro            │ https://prod.ideaxion.cloud     │
# └────────────────────────────────────────────────────────────────────────────┘
# =============================================================================

# --- API (server-only, le BFF appelle ce backend ; SANS /api/v1, inclus dans les chemins) ---
BACKEND_API_URL=http://127.0.0.1:8082

# --- URL publique de CE front (SEO, canonical, hreflang, liens) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Feature flags produit (V2 masqué) — "true"/"1" pour activer, sinon off ---
NEXT_PUBLIC_FEATURE_PITCH_SIM=false
NEXT_PUBLIC_FEATURE_MENTORS=false
